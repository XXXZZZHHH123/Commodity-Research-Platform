[Unit]
Description=Commodity Research Platform daily data ingestion
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=commodity
Group=commodity
WorkingDirectory=/opt/commodity-research-platform/current
EnvironmentFile=/etc/commodity-research-platform/app.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/commodity-research-platform/current/.venv/bin/python -m tin.jobs daily
UMask=0002
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/commodity-research-platform

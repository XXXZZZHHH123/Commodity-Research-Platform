[Unit]
Description=Run commodity data ingestion twice on weekdays

[Timer]
# Older systemd releases do not accept a named timezone suffix. These times use
# the host timezone; deployment warns when the host is not Asia/Shanghai.
OnCalendar=Mon-Fri *-*-* 08:00:00
OnCalendar=Mon-Fri *-*-* 16:30:00
Persistent=true
Unit=commodity-research-platform-daily.service

[Install]
WantedBy=timers.target

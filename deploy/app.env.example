# Prefer PostgreSQL when multiple users or processes access the platform.
# TIN_DATABASE_URL=postgresql+psycopg://tin:change-me@127.0.0.1:5432/tin

# SQLite is supported for a single web worker on one host.
TIN_DATABASE_URL=sqlite:////var/lib/commodity-research-platform/data/tin.db
TIN_EXPORTS_DIR=/var/lib/commodity-research-platform/exports
TIN_VARIETY=SN
TIN_LIQUIDITY_MIN_VOLUME=500
TIN_HTTP_TIMEOUT=40
